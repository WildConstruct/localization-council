# Export these environment variables in your shell or CI, or load a local file with
# `node --env-file=.env src/cli.mjs …` (Node >= 20.6). Never commit real keys.

# OpenRouter profile: one key for every stage (models in config/models.json)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=        # optional proxy / test override
# OPENROUTER_TIMEOUT_MS=120000
# OPENROUTER_MAX_RETRIES=3
# OPENROUTER_BATCH_SIZE=      # optional: items per request for every stage

# Default profile when --profile is not given (mock | openrouter | fleet)
# COUNCIL_PROFILE=mock

# Default OpenRouter model preset (balanced | budget; see config/models.json openrouter.presets)
# COUNCIL_PRESET=

# Fleet profile: local CLIs (binary names or absolute/relative paths)
# CLAUDE_CLI_BIN=claude
# GROK_CLI_BIN=grok
# CODEX_CLI_BIN=codex
# CLAUDE_MODEL=               # default in config/models.json; per stage: CLAUDE_TRANSLATE_MODEL / CLAUDE_BT_MODEL / CLAUDE_JUDGE_MODEL
# CLAUDE_EFFORT=
# CLAUDE_TIMEOUT_MS=180000
# CLAUDE_CLI_BARE=0           # 1 only on API-key machines (skips OAuth/keychain)
# CODEX_MODEL=                # unset uses the Codex CLI default; per stage: CODEX_TRANSLATE_MODEL / CODEX_BT_MODEL / CODEX_JUDGE_MODEL
# CODEX_TIMEOUT_MS=180000
# GROK_TIMEOUT_MS=180000
# GROK_CLI_ALWAYS_APPROVE=0

# Optional Jev judge (judge=api:jev); uses OPENROUTER_API_KEY
# JEV_MODEL=                  # default in config/models.json (jev.defaultModel)

# Allow a glossary whose locale differs from --locale
# GLOSSARY_LOCALE_OVERRIDE=0
